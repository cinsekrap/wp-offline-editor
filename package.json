{
  "name": "np-presspad",
  "version": "1.3.2",
  "description": "NP Presspad",
  "main": "./out/main/index.js",
  "author": "",
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "node scripts/bundle-release-notes.mjs && electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:ci": "vitest run",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:plugin": "rm -f resources/wp-offline-editor-companion.zip && ln -sfn companion-plugin wp-offline-editor-companion && zip -r resources/wp-offline-editor-companion.zip wp-offline-editor-companion/ -x 'wp-offline-editor-companion/.*' && rm wp-offline-editor-companion",
    "build:mac": "node scripts/bump-build.js && pnpm build && electron-builder --mac"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.1",
    "electron-builder": "26.8.1",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "lowlight": "^3.3.0",
    "marked": "^18.0.11",
    "react-day-picker": "^10.0.1",
    "react-easy-crop": "^6.2.3",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.4",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  }
}
